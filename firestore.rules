rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(id) {
      return id is string && id.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Entities Validations
    function isValidPhoto(data) {
      return data.keys().hasAll(['id', 'imageUrl', 'title', 'date', 'visible']) &&
             data.keys().size() <= 7 &&
             data.id is string && data.id.size() <= 128 &&
             data.imageUrl is string && data.imageUrl.size() <= 100000 &&
             data.title is string && data.title.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.visible is bool &&
             (!data.keys().hasAny(['comment']) || (data.comment is string && data.comment.size() <= 1000));
    }

    function isValidDiary(data) {
      return data.keys().hasAll(['id', 'author', 'title', 'content', 'date', 'visible']) &&
             data.keys().size() <= 9 &&
             data.id is string && data.id.size() <= 128 &&
             data.author is string && (data.author == 'smile' || data.author == 'caramel') &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 10000 &&
             data.date is string && data.date.size() <= 32 &&
             data.visible is bool &&
             (!data.keys().hasAny(['response']) || (data.response is string && data.response.size() <= 10000)) &&
             (!data.keys().hasAny(['stickers']) || (data.stickers is list && data.stickers.size() <= 32)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'date', 'visible']) &&
             data.keys().size() <= 7 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 10000 &&
             data.date is string && data.date.size() <= 32 &&
             data.visible is bool;
    }

    function isValidFortune(data) {
      return data.keys().hasAll(['id', 'season', 'title', 'resultName', 'resultMessage', 'visible', 'sortOrder']) &&
             data.keys().size() <= 17 &&
             data.id is string && data.id.size() <= 128 &&
             data.season is string && data.season.size() <= 64 &&
             data.title is string && data.title.size() <= 128 &&
             data.resultName is string && data.resultName.size() <= 32 &&
             data.resultMessage is string && data.resultMessage.size() <= 1000 &&
             data.visible is bool &&
             data.sortOrder is int &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 100000)) &&
             (!data.keys().hasAny(['commentSmile']) || (data.commentSmile is string && data.commentSmile.size() <= 1000)) &&
             (!data.keys().hasAny(['commentCaramel']) || (data.commentCaramel is string && data.commentCaramel.size() <= 1000)) &&
             (!data.keys().hasAny(['luckyItem']) || (data.luckyItem is string && data.luckyItem.size() <= 256)) &&
             (!data.keys().hasAny(['luckyDance']) || (data.luckyDance is string && data.luckyDance.size() <= 256)) &&
             (!data.keys().hasAny(['ratingSmile']) || data.ratingSmile is int) &&
             (!data.keys().hasAny(['ratingCaramel']) || data.ratingCaramel is int) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!data.keys().hasAny(['rarity']) || (data.rarity is string && data.rarity.size() <= 32)) &&
             (!data.keys().hasAny(['startDate']) || (data.startDate is string && data.startDate.size() <= 32)) &&
             (!data.keys().hasAny(['endDate']) || (data.endDate is string && data.endDate.size() <= 32));
    }

    function isValidLetter(data) {
      return data.keys().hasAll(['id', 'season', 'title', 'content', 'smileContent', 'caramelContent', 'visible']) &&
             data.keys().size() <= 10 &&
             data.id is string && data.id.size() <= 128 &&
             data.season is string && data.season.size() <= 64 &&
             data.title is string && data.title.size() <= 128 &&
             data.content is string && data.content.size() <= 10000 &&
             data.smileContent is string && data.smileContent.size() <= 10000 &&
             data.caramelContent is string && data.caramelContent.size() <= 10000 &&
             data.visible is bool &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 100000)) &&
             (!data.keys().hasAny(['startDate']) || (data.startDate is string && data.startDate.size() <= 32)) &&
             (!data.keys().hasAny(['endDate']) || (data.endDate is string && data.endDate.size() <= 32)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidStatValue(value) {
      return value is int && value >= 0 && value <= 1000000;
    }

    function isValidDailyStat(data) {
      return data.keys().hasOnly(['pageViews', 'fortunesDrawn', 'completions', 'galleryViews', 'snsClicks', 'videoClicks']) &&
             (!data.keys().hasAny(['pageViews']) || isValidStatValue(data.pageViews)) &&
             (!data.keys().hasAny(['fortunesDrawn']) || isValidStatValue(data.fortunesDrawn)) &&
             (!data.keys().hasAny(['completions']) || isValidStatValue(data.completions)) &&
             (!data.keys().hasAny(['galleryViews']) || isValidStatValue(data.galleryViews)) &&
             (!data.keys().hasAny(['snsClicks']) || isValidStatValue(data.snsClicks)) &&
             (!data.keys().hasAny(['videoClicks']) || isValidStatValue(data.videoClicks));
    }

    function isSingleInitialStatCreate(data) {
      return isValidDailyStat(data) &&
             data.keys().size() == 1 &&
             ((!data.keys().hasAny(['pageViews']) || data.pageViews == 1) &&
              (!data.keys().hasAny(['fortunesDrawn']) || data.fortunesDrawn == 1) &&
              (!data.keys().hasAny(['completions']) || data.completions == 1) &&
              (!data.keys().hasAny(['galleryViews']) || data.galleryViews == 1) &&
              (!data.keys().hasAny(['snsClicks']) || data.snsClicks == 1) &&
              (!data.keys().hasAny(['videoClicks']) || data.videoClicks == 1));
    }

    function isSingleStatIncrement(data, oldData) {
      return isValidDailyStat(data) &&
             data.diff(oldData).affectedKeys().hasOnly(['pageViews', 'fortunesDrawn', 'completions', 'galleryViews', 'snsClicks', 'videoClicks']) &&
             data.diff(oldData).affectedKeys().size() == 1 &&
             (!data.diff(oldData).affectedKeys().hasAny(['pageViews']) ||
               data.pageViews == (oldData.keys().hasAny(['pageViews']) ? oldData.pageViews + 1 : 1)) &&
             (!data.diff(oldData).affectedKeys().hasAny(['fortunesDrawn']) ||
               data.fortunesDrawn == (oldData.keys().hasAny(['fortunesDrawn']) ? oldData.fortunesDrawn + 1 : 1)) &&
             (!data.diff(oldData).affectedKeys().hasAny(['completions']) ||
               data.completions == (oldData.keys().hasAny(['completions']) ? oldData.completions + 1 : 1)) &&
             (!data.diff(oldData).affectedKeys().hasAny(['galleryViews']) ||
               data.galleryViews == (oldData.keys().hasAny(['galleryViews']) ? oldData.galleryViews + 1 : 1)) &&
             (!data.diff(oldData).affectedKeys().hasAny(['snsClicks']) ||
               data.snsClicks == (oldData.keys().hasAny(['snsClicks']) ? oldData.snsClicks + 1 : 1)) &&
             (!data.diff(oldData).affectedKeys().hasAny(['videoClicks']) ||
               data.videoClicks == (oldData.keys().hasAny(['videoClicks']) ? oldData.videoClicks + 1 : 1));
    }

    function isValidGachaState(data) {
      return data.keys().hasAll(['lastDrawDate', 'todayFortune', 'collection', 'visitorName']) &&
             data.keys().size() <= 5 &&
             data.lastDrawDate is string && data.lastDrawDate.size() <= 32 &&
             (data.todayFortune == null || data.todayFortune is map) &&
             data.collection is list && data.collection.size() <= 100 &&
             data.visitorName is string && data.visitorName.size() <= 30 &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidFanComment(data) {
      return data.keys().hasAll(['diaryId', 'authorUid', 'userName', 'avatarSeed', 'content', 'timestamp', 'stickyColor', 'createdAt']) &&
             data.keys().size() <= 8 &&
             data.diaryId is string && data.diaryId.size() <= 128 &&
             data.authorUid is string && data.authorUid == request.auth.uid &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 20 &&
             data.avatarSeed is string && data.avatarSeed.size() <= 128 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 120 &&
             data.timestamp is string && data.timestamp.size() <= 32 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.stickyColor is string &&
             (data.stickyColor == 'pink' ||
              data.stickyColor == 'yellow' ||
              data.stickyColor == 'orange' ||
              data.stickyColor == 'green' ||
              data.stickyColor == 'blue');
    }

    function isValidLikeReaction(data, reactionId) {
      return data.keys().hasAll(['kind', 'targetId', 'authorUid', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.kind is string &&
             (data.kind == 'dance_video' || data.kind == 'music_track') &&
             isValidId(data.targetId) &&
             data.authorUid is string &&
             data.authorUid == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             reactionId == data.kind + '_' + data.targetId + '_' + request.auth.uid;
    }

    function isValidDanceVideo(data) {
      return data.keys().hasAll(['title', 'description', 'youtubeUrl', 'heartsCount', 'visible', 'sortOrder']) &&
             data.keys().size() <= 12 &&
             data.title is string && data.title.size() <= 256 &&
             data.description is string && data.description.size() <= 1000 &&
             data.youtubeUrl is string && data.youtubeUrl.size() <= 100000 &&
             (!data.keys().hasAny(['thumbnailUrl']) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 100000)) &&
             (!data.keys().hasAny(['releasedDate']) || (data.releasedDate is string && data.releasedDate.size() <= 32)) &&
             (!data.keys().hasAny(['originalSong']) || (data.originalSong is string && data.originalSong.size() <= 256)) &&
             (!data.keys().hasAny(['smileComment']) || (data.smileComment is string && data.smileComment.size() <= 1000)) &&
             (!data.keys().hasAny(['caramelComment']) || (data.caramelComment is string && data.caramelComment.size() <= 1000)) &&
             data.heartsCount is int &&
             data.visible is bool &&
             data.sortOrder is int &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMusicTrack(data) {
      return data.keys().hasAll(['title', 'description', 'youtubeUrl', 'likes', 'visible', 'sortOrder']) &&
             data.keys().size() <= 10 &&
             data.title is string && data.title.size() <= 128 &&
             data.description is string && data.description.size() <= 256 &&
             data.youtubeUrl is string && data.youtubeUrl.size() <= 100000 &&
             (!data.keys().hasAny(['thumbnailUrl']) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 100000)) &&
             (!data.keys().hasAny(['composer']) || (data.composer is string && data.composer.size() <= 128)) &&
             (!data.keys().hasAny(['notes']) || data.notes is list) &&
             data.likes is int &&
             data.visible is bool &&
             data.sortOrder is int &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMemberProfile(data) {
      return data.keys().hasAll(['name', 'jpName', 'color', 'subColor', 'signature', 'tagline', 'birthday', 'bloodType', 'likes', 'dislikes', 'message', 'stickerStyle']) &&
             data.keys().size() <= 14 &&
             data.name is string && data.name.size() <= 64 &&
             data.jpName is string && data.jpName.size() <= 64 &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 100000)) &&
             data.color is string && data.color.size() <= 32 &&
             data.subColor is string && data.subColor.size() <= 32 &&
             data.signature is string && data.signature.size() <= 256 &&
             data.tagline is string && data.tagline.size() <= 512 &&
             data.birthday is string && data.birthday.size() <= 128 &&
             data.bloodType is string && data.bloodType.size() <= 128 &&
             data.likes is list && data.likes.size() <= 32 &&
             data.dislikes is list && data.dislikes.size() <= 32 &&
             data.message is string && data.message.size() <= 2000 &&
             data.stickerStyle is string && data.stickerStyle.size() <= 256 &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSiteImages(data) {
      return data.keys().hasAll(['mainVisualUrl', 'logoUrl', 'footerLogoUrl']) &&
             data.keys().size() <= 4 &&
             data.mainVisualUrl is string && data.mainVisualUrl.size() <= 100000 &&
             data.logoUrl is string && data.logoUrl.size() <= 100000 &&
             data.footerLogoUrl is string && data.footerLogoUrl.size() <= 100000 &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Rules Matches
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPhoto(request.resource.data) && isValidId(photoId);
      allow update: if isAdmin() && isValidPhoto(request.resource.data) && isValidId(photoId);
      allow delete: if isAdmin();
    }

    match /diaries/{diaryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidDiary(request.resource.data) && isValidId(diaryId);
      allow update: if isAdmin() && isValidDiary(request.resource.data) && isValidId(diaryId);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin() && isValidAnnouncement(request.resource.data) && isValidId(announcementId);
      allow update: if isAdmin() && isValidAnnouncement(request.resource.data) && isValidId(announcementId);
      allow delete: if isAdmin();
    }

    match /fortunes/{fortuneId} {
      allow read: if true;
      allow create: if isAdmin() && isValidFortune(request.resource.data) && fortuneId is string && fortuneId.size() <= 128;
      allow update: if isAdmin() && isValidFortune(request.resource.data) && fortuneId is string && fortuneId.size() <= 128;
      allow delete: if isAdmin();
    }

    match /letters/{letterId} {
      allow read: if true;
      allow create: if isAdmin() && isValidLetter(request.resource.data) && isValidId(letterId);
      allow update: if isAdmin() && isValidLetter(request.resource.data) && isValidId(letterId);
      allow delete: if isAdmin();
    }

    match /dance_videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDanceVideo(request.resource.data) && isValidId(videoId);
      allow delete: if isAdmin();
    }

    match /music_tracks/{trackId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMusicTrack(request.resource.data) && isValidId(trackId);
      allow delete: if isAdmin();
    }

    match /member_profiles/{profileId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        (profileId == 'smile' || profileId == 'caramel') &&
        isValidMemberProfile(request.resource.data);
      allow delete: if false;
    }

    match /site_settings/{settingsId} {
      allow read: if settingsId == 'images';
      allow create, update: if isAdmin() &&
        settingsId == 'images' &&
        isValidSiteImages(request.resource.data);
      allow delete: if false;
    }

    match /daily_stats/{dateStr} {
      allow read: if isAdmin();
      allow create: if isValidDateId(dateStr) && isSingleInitialStatCreate(request.resource.data);
      allow update: if isValidDateId(dateStr) && isSingleStatIncrement(request.resource.data, resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId}/gacha/{stateId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        stateId == 'state' &&
        isValidGachaState(request.resource.data);
      allow delete: if isOwner(userId) && stateId == 'state';
    }

    match /fan_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && isValidFanComment(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /like_reactions/{reactionId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidLikeReaction(request.resource.data, reactionId);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(userId);
    }
  }
}
